{
  "name": "agyp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/main.js",
    "dev": "tsx server/main.ts",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx test/browser.ts",
    "check": "tsc --noEmit",
    "test:integration": "tsx test/integration-browser.ts",
    "test:cli": "tsx test/cli-e2e.ts",
    "build:web": "npm --prefix ui ci && npm --prefix ui run build"
  },
  "dependencies": {
    "cookie": "^1.0.2",
    "eventsource-parser": "^3.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
